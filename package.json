{
  "name": "anydj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DJ-Software mit lokaler Musikanalyse, DMX-Lichtsteuerung und 3D-Vorschau",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "lan": "node scripts/dev-https.mjs --lan",
    "demo": "node server.mjs --demo",
    "test": "node --test test/*.test.mjs",
    "desktop": "node scripts/start-desktop.mjs",
    "desktop:gpu": "node scripts/start-desktop.mjs --high-performance-gpu",
    "pack": "node scripts/pack.mjs",
    "pack:linux": "node scripts/pack.mjs --linux",
    "pack:win": "node scripts/pack.mjs --win",
    "pack:mac": "node scripts/pack.mjs --mac",
    "pack:analysis": "node scripts/prepare-analysis-bundle.mjs",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "node scripts/preview-web.mjs",
    "build:hosting": "node scripts/build-hosting.mjs",
    "start:hosting": "node dist/hosting/index.js",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check",
    "deploy:restart": "node scripts/deploy.mjs --restart",
    "deploy:rollback": "node scripts/deploy.mjs --rollback",
    "dev:https": "node scripts/dev-https.mjs",
    "dev:cert": "node scripts/dev-https.mjs --cert-only",
    "build:tutorial": "node scripts/build-dj-tutorial.mjs",
    "release:desktop": "node scripts/release-desktop.mjs",
    "deploy:full": "node scripts/deploy-full.mjs",
    "deploy:web": "node scripts/deploy.mjs",
    "vr:sim": "node scripts/start-vr-sim.mjs",
    "deploy:apps": "node scripts/deploy-apps.mjs",
    "init:apps": "node scripts/init-apps.mjs",
    "deploy:all": "node scripts/deploy-all.mjs",
    "deploy:all:check": "node scripts/deploy-all.mjs --check",
    "sync:all": "node scripts/deploy-all.mjs --sync-only",
    "deploy:downloads": "node scripts/deploy-all.mjs --publish-only"
  },
  "main": "desktop/main.mjs",
  "author": "AnyDj",
  "devDependencies": {
    "@iwer/devui": "^2.5.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0"
  },
  "homepage": "https://github.com/BakuraRyou/anydj",
  "dependencies": {
    "iwer": "^2.5.0"
  }
}
